// Duplicado para efecto de carrusel continuo e infinito sin cortes
const fullStack = [...technologies, ...technologies];
---

<section class="marquee-section" aria-label="Tecnologías y herramientas con las que trabajamos">
  <div class="marquee-container">
    <div class="marquee-header">
      <span class="marquee-label">Tecnologías & Herramientas de Vanguardia</span>
    </div>
    <div class="marquee-track">
      <div class="marquee-inner">
        {fullStack.map((tech) => (
          <div class="marquee-pill">
            <span class="marquee-icon" set:html={tech.svg} aria-hidden="true" />
            <span class="marquee-text">{tech.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
