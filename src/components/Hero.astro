---
// Hero Component - Fiel al diseño exacto de Clay Global
// Headline contundente a la izquierda y objeto 3D minimalista/escultural con código interactivo a la derecha
---
<section class="clay-hero-section">
  <div class="clay-container">
    <div class="clay-hero-main-layout">
      <!-- Columna Izquierda: Headline contundente como Clay -->
      <div class="clay-hero-left gs-clay-title">
        <h1 class="clay-hero-headline">
          Monni es una agencia de diseño y desarrollo web para empresas.
        </h1>
        <p class="clay-hero-subtext">
          Creamos experiencias digitales a medida, rápidas y memorables. Diseñamos marcas y desarrollamos sitios web optimizados para convertir visitantes en clientes reales.
        </p>
        <div class="clay-hero-actions">
          <a href="#contacto" class="clay-btn-pill">
            Iniciar Proyecto
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
          </a>
          <a href="#proyectos" class="clay-btn-subtle">
            Ver Proyectos
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Objeto minimalista 3D interactivo con código sutil / micro-animación -->
      <!-- Columna Derecha: Mockup de página web minimalista con código y badge interactivos -->
      <div class="clay-hero-right gs-clay-visual">
        <div class="sculpture-scene" id="sculptureScene">
          <!-- Ventana de página web moderna y minimalista con sombras suaves -->
          <div class="hero-web-frame" id="sculptureMain">
            <!-- Barra superior del navegador -->
            <div class="web-frame-bar">
              <div class="web-frame-dots">
                <span></span><span></span><span></span>
              </div>
              <div class="web-frame-address">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>tuempresa.com</span>
              </div>
            </div>

            <!-- Contenido interior minimalista de la web -->
            <div class="web-frame-canvas">
              <div class="web-canvas-nav">
                <div class="canvas-brand-skeleton"></div>
                <div class="canvas-links-skeleton">
                  <span></span><span></span><span></span>
                </div>
              </div>
              <div class="web-canvas-hero">
                <div class="canvas-headline-skeleton"></div>
                <div class="canvas-headline-skeleton canvas-headline-skeleton--short"></div>
                <div class="canvas-text-skeleton"></div>
                <div class="canvas-btn-skeleton"></div>
              </div>
            </div>

            <!-- Ventana flotante de código limpio / inspección web minimalista (mantenida) -->
            <div class="sculpture-code-card" id="codeCard">
              <div class="code-card-header">
                <div class="code-dots">
                  <span></span><span></span><span></span>
                </div>
                <span class="code-filename">App.tsx</span>
              </div>
              <div class="code-card-body">
                <div class="code-row"><span class="c-kw">const</span> <span class="c-fn">createWebsite</span> = () =&gt; &#123;</div>
                <div class="code-row c-indent"><span class="c-prop">speed:</span> <span class="c-str">'&lt;0.8s'</span>,</div>
                <div class="code-row c-indent"><span class="c-prop">design:</span> <span class="c-str">'tailored'</span>,</div>
                <div class="code-row c-indent"><span class="c-prop">conversion:</span> <span class="c-num">+140%</span></div>
                <div class="code-row">&#125;;</div>
              </div>
            </div>

            <!-- Badge de rendimiento minimalista PageSpeed 99 (mantenido) -->
            <div class="sculpture-metric-badge" id="metricBadge">
              <span class="metric-score">99</span>
              <div class="metric-info">
                <strong>PageSpeed</strong>
                <span>Optimizado</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Indicadores esenciales para el cliente B2B (Minimalistas de 1px) -->
    <div class="clay-specs-grid gs-clay-specs">
      <div class="clay-spec-item">
        <span class="clay-spec-label">Enfoque</span>
        <strong class="clay-spec-val">Diseño &amp; Código a Mano</strong>
      </div>
      <div class="clay-spec-item">
        <span class="clay-spec-label">Tiempo de Entrega</span>
        <strong class="clay-spec-val">2 a 3 Semanas</strong>
      </div>
      <div class="clay-spec-item">
        <span class="clay-spec-label">Rendimiento</span>
        <strong class="clay-spec-val">&lt; 1s Tiempo de Carga</strong>
      </div>
      <div class="clay-spec-item">
        <span class="clay-spec-label">Propiedad</span>
        <strong class="clay-spec-val">100% de tu Empresa</strong>
      </div>
    </div>
  </div>
</section>

<!-- Barra sutil de capacidades -->
<section class="clay-disciplines-section">
  <div class="clay-container">
    <div class="clay-disciplines-bar">
      <div class="clay-disc-tags">
        <span>Sitios Web Corporativos</span>
        <span class="clay-bullet">/</span>
        <span>Landing Pages de Conversión</span>
        <span class="clay-bullet">/</span>
        <span>Tiendas E-commerce</span>
        <span class="clay-bullet">/</span>
        <span>Diseño UI/UX en Figma</span>
        <span class="clay-bullet">/</span>
        <span>Optimización SEO</span>
      </div>
    </div>
  </div>
</section>
